#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${KOKORO_ENV_FILE:-$HOME/.env.tts}"
if [ -f "$ENV_FILE" ]; then
  # shellcheck source=/dev/null
  source "$ENV_FILE"
fi

tts_state_dir() {
  if [ -n "${TTS_STATE_DIR:-}" ]; then
    printf '%s\n' "$TTS_STATE_DIR"
  elif [ -n "${XDG_STATE_HOME:-}" ]; then
    printf '%s/tts\n' "$XDG_STATE_HOME"
  elif [ -n "${HOME:-}" ]; then
    printf '%s/.local/state/tts\n' "$HOME"
  else
    printf '/tmp/tts-state\n'
  fi
}

truthy() {
  case "${1:-}" in
    1|true|True|TRUE|yes|Yes|YES|on|On|ON)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

first_environment_value() {
  local name value
  for name in "$@"; do
    value="${!name:-}"
    if [ -n "$value" ]; then
      printf '%s\n' "$value"
      return 0
    fi
  done
  return 1
}

infer_harness() {
  local explicit
  explicit="$(first_environment_value TTS_HARNESS WTG_HARNESS 2>/dev/null || true)"
  if [ -n "$explicit" ]; then
    printf '%s\n' "$explicit"
  elif [ -n "${TENEX_EDGE_SESSION_ID:-}" ] || [ -n "${TENEX_AGENT_NAME:-}" ]; then
    printf 'tenex-edge\n'
  elif [ -n "${CODEX_THREAD_ID:-}" ]; then
    printf 'codex\n'
  elif [ -n "${CLAUDE_SESSION_ID:-}" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
    printf 'claude\n'
  fi
}

infer_session_id() {
  first_environment_value \
    TTS_SESSION_ID \
    TENEX_EDGE_SESSION_ID \
    CODEX_THREAD_ID \
    CLAUDE_SESSION_ID \
    WTG_SESSION_ID \
    2>/dev/null || true
}

macos_menu_enabled() {
  [ "$(uname -s)" = "Darwin" ] && truthy "${TTS_MACOS_MENU:-1}"
}

SPEECH_GATE_HELD=0
SPEECH_GATE_DIR=""
SPEECH_GATE_POLL_SECONDS="${TTS_SPEECH_GATE_POLL_SECONDS:-0.2}"
SPEECH_GATE_STALE_SECONDS="${TTS_SPEECH_GATE_STALE_SECONDS:-3600}"

process_is_alive() {
  local pid="$1"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  return 1
}

path_mtime_epoch() {
  local path="$1"
  stat -f %m "$path" 2>/dev/null || stat -c %Y "$path" 2>/dev/null || true
}

release_speech_gate() {
  if [ "$SPEECH_GATE_HELD" -ne 1 ] || [ -z "$SPEECH_GATE_DIR" ]; then
    return 0
  fi

  rm -rf "$SPEECH_GATE_DIR"
  SPEECH_GATE_HELD=0
}

lock_is_stale() {
  local owner_file="$1"
  local owner_pid=""
  local owner_started=""
  local now age

  if [ -r "$owner_file" ]; then
    {
      IFS= read -r owner_pid || true
      IFS= read -r owner_started || true
    } < "$owner_file"
  else
    owner_started="$(path_mtime_epoch "${owner_file%/owner}")"
  fi

  if [ -n "$owner_pid" ] && ! process_is_alive "$owner_pid"; then
    return 0
  fi

  if [[ "$owner_started" =~ ^[0-9]+$ ]] && [[ "$SPEECH_GATE_STALE_SECONDS" =~ ^[0-9]+$ ]]; then
    now=$(date +%s)
    age=$(( now - owner_started ))
    if [ "$age" -gt "$SPEECH_GATE_STALE_SECONDS" ]; then
      return 0
    fi
  fi

  return 1
}

acquire_speech_gate() {
  local state_dir owner_file warned=0
  state_dir="$(tts_state_dir)"
  if ! mkdir -p "$state_dir" 2>/dev/null; then
    state_dir="/tmp/tts-state"
    mkdir -p "$state_dir" 2>/dev/null || state_dir="/tmp"
  fi

  SPEECH_GATE_DIR="$state_dir/speech.lock"
  owner_file="$SPEECH_GATE_DIR/owner"

  while true; do
    if mkdir "$SPEECH_GATE_DIR" 2>/dev/null; then
      SPEECH_GATE_HELD=1
      {
        printf '%s\n' "$$"
        date +%s
      } > "$owner_file" 2>/dev/null || true
      return 0
    fi

    if lock_is_stale "$owner_file"; then
      rm -rf "$SPEECH_GATE_DIR"
      continue
    fi

    if [ "$warned" -eq 0 ]; then
      echo "Waiting for active TTS speech to finish..." >&2
      warned=1
    fi
    sleep "$SPEECH_GATE_POLL_SECONDS"
  done
}

usage() {
  echo "Usage: ./scripts/tts [options] 'Your text here'" >&2
  echo "Generates speech in the foreground, then queues playback in the background." >&2
  echo "Options:" >&2
  echo "  --agent-name name          Stable agent identity when one exists beyond the harness name." >&2
  echo "  --introduction text        Brief identity/work context, 30 words or fewer." >&2
  echo "  --subject text             Optional spoken/display subject, 5 to 10 words." >&2
  echo "  --voice-id voice           Explicit Kokoro voice id." >&2
  echo "  --no-play                  Print target MP3 path and generate it without playback." >&2
  echo "  --no-media-pause           Do not pause/resume media apps." >&2
  echo "  --resume-delay seconds     Delay before resuming paused media." >&2
  echo "Example: ./scripts/tts --agent-name quinn-delta-306 --introduction 'Agent Quinn here, working on TTS.' --subject 'Playback queue ownership is now explicit' 'The fix is ready.'" >&2
}

NO_PLAY=0
MEDIA_CONTROL="${TTS_MEDIA_CONTROL:-1}"
RESUME_DELAY="${TTS_RESUME_DELAY_SECONDS:-3}"
INTRODUCTION=""
SUBJECT=""
AGENT_NAME=""
VOICE_ID=""
PLAY_EXISTING_FILE=""
INTRO_RECENT_SECONDS=600
DETERMINISTIC_VOICES=(af_bella af_heart af_kore af_nova af_sarah am_michael am_puck)
POSITIONAL=()

normalize_space() {
  printf '%s' "$1" | tr -s '[:space:]' ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

word_count() {
  printf '%s\n' "$1" | awk '{ count += NF } END { print count + 0 }'
}

agent_identity() {
  if [ -n "$AGENT_NAME" ]; then
    printf 'name:%s\n' "$AGENT_NAME"
  else
    printf 'ppid:%s\n' "${TTS_CALLER_PPID:-$PPID}"
  fi
}

intro_state_dir() {
  tts_state_dir
}

select_voice_from_seed() {
  local seed="$1"
  local checksum index
  checksum=$(printf '%s' "$seed" | cksum | awk '{ print $1 }')
  index=$(( checksum % ${#DETERMINISTIC_VOICES[@]} ))
  printf '%s\n' "${DETERMINISTIC_VOICES[$index]}"
}

should_prepend_introduction() {
  if [ -z "$INTRODUCTION" ]; then
    return 1
  fi

  local now last_spoken_at last_agent_id age
  now=$(date +%s)
  last_spoken_at=""
  last_agent_id=""

  if [ -r "$INTRO_STATE_FILE" ]; then
    {
      IFS= read -r last_spoken_at || true
      IFS= read -r last_agent_id || true
    } < "$INTRO_STATE_FILE"
  fi

  if [ "$last_agent_id" = "$AGENT_ID" ] && [[ "$last_spoken_at" =~ ^[0-9]+$ ]]; then
    age=$(( now - last_spoken_at ))
    if [ "$age" -ge 0 ] && [ "$age" -le "$INTRO_RECENT_SECONDS" ]; then
      return 1
    fi
  fi

  return 0
}

prepend_spoken_segment() {
  local segment="$1"
  local text="$2"
  case "$segment" in
    *[.!?])
      printf '%s %s\n' "$segment" "$text"
      ;;
    *)
      printf '%s. %s\n' "$segment" "$text"
      ;;
  esac
}

record_agent_spoken() {
  local now tmp
  now=$(date +%s)

  if ! mkdir -p "$INTRO_STATE_DIR" 2>/dev/null; then
    return 0
  fi

  tmp="$INTRO_STATE_FILE.$$"
  if {
    printf '%s\n' "$now"
    printf '%s\n' "$AGENT_ID"
  } > "$tmp"; then
    mv "$tmp" "$INTRO_STATE_FILE" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
}

queue_macos_playback() {
  local state_dir items_dir item_id item_file temporary_file
  local harness session_id workspace inferred_agent menu_command

  if ! command -v python3 >/dev/null 2>&1; then
    echo "Warning: python3 is unavailable; using fallback TTS playback." >&2
    return 1
  fi

  menu_command="${TTS_MENU_COMMAND:-$SCRIPT_DIR/tts-menu}"
  if [ ! -x "$menu_command" ]; then
    echo "Warning: TTS menu launcher is unavailable; using fallback playback." >&2
    return 1
  fi

  state_dir="$(tts_state_dir)"
  items_dir="$state_dir/items"
  mkdir -p "$items_dir" || return 1

  item_id="$(date +%s)-$$-$RANDOM"
  item_file="$items_dir/$item_id.json"
  temporary_file="$items_dir/.$item_id.tmp"
  harness="$(infer_harness)"
  session_id="$(infer_session_id)"
  workspace="${TTS_WORKSPACE:-${WTG_WORKTREE_PATH:-$(pwd -P)}}"
  inferred_agent="${AGENT_NAME:-${TTS_AGENT_NAME:-${TENEX_AGENT_NAME:-}}}"

  if ! python3 - \
    "$temporary_file" \
    "$item_id" \
    "$TEXT" \
    "$SUBJECT" \
    "$inferred_agent" \
    "$harness" \
    "$session_id" \
    "$workspace" \
    "$VOICE" \
    "$OUTPUT_FILE" \
    "$(date +%s)" <<'PY'
import json
import sys

(
    destination,
    item_id,
    text,
    subject,
    agent_name,
    harness,
    session_id,
    workspace,
    voice,
    output_file,
    created_at,
) = sys.argv[1:]

def optional(value):
    return value or None

item = {
    "id": item_id,
    "text": text,
    "subject": optional(subject),
    "agent_name": optional(agent_name),
    "harness": optional(harness),
    "session_id": optional(session_id),
    "workspace": optional(workspace),
    "voice": voice,
    "output_file": output_file,
    "status": "queued",
    "created_at": int(created_at),
    "started_at": None,
    "completed_at": None,
    "duration": None,
    "error": None,
}

with open(destination, "w", encoding="utf-8") as handle:
    json.dump(item, handle, indent=2, sort_keys=True)
    handle.write("\n")
PY
  then
    rm -f "$temporary_file"
    return 1
  fi

  resume_paused_media 0
  mv "$temporary_file" "$item_file"
  if env \
    TTS_MEDIA_CONTROL="$MEDIA_CONTROL" \
    TTS_RESUME_DELAY_SECONDS="$RESUME_DELAY" \
    "$menu_command" start >/dev/null; then
    record_agent_spoken
    printf 'Queued TTS in macOS menu bar: %s\n' "$item_id" >&2
    return 0
  fi

  rm -f "$item_file"
  echo "Warning: native TTS queue failed to start; using fallback playback." >&2
  return 1
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-play)
      NO_PLAY=1
      shift
      ;;
    --no-media-pause)
      MEDIA_CONTROL=0
      shift
      ;;
    --resume-delay)
      if [ -z "${2:-}" ]; then
        echo "Error: --resume-delay requires a value in seconds." >&2
        exit 1
      fi
      RESUME_DELAY="$2"
      shift 2
      ;;
    --agent-name)
      if [ -z "${2:-}" ]; then
        echo "Error: --agent-name requires a value." >&2
        exit 1
      fi
      AGENT_NAME="$2"
      shift 2
      ;;
    --introduction)
      if [ -z "${2:-}" ]; then
        echo "Error: --introduction requires a value." >&2
        exit 1
      fi
      INTRODUCTION="$2"
      shift 2
      ;;
    --subject)
      if [ -z "${2:-}" ]; then
        echo "Error: --subject requires a value." >&2
        exit 1
      fi
      SUBJECT="$2"
      shift 2
      ;;
    --voice-id)
      if [ -z "${2:-}" ]; then
        echo "Error: --voice-id requires a value." >&2
        exit 1
      fi
      VOICE_ID="$2"
      shift 2
      ;;
    --play-existing)
      if [ -z "${2:-}" ]; then
        echo "Error: --play-existing requires a file path." >&2
        exit 1
      fi
      PLAY_EXISTING_FILE="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        POSITIONAL+=( "$1" )
        shift
      done
      break
      ;;
    -*)
      echo "Error: unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      POSITIONAL+=( "$1" )
      shift
      ;;
  esac
done

if [ -n "$PLAY_EXISTING_FILE" ] && [ "${#POSITIONAL[@]}" -gt 0 ]; then
  echo "Error: --play-existing does not accept text arguments." >&2
  usage
  exit 1
fi

if [ "${#POSITIONAL[@]}" -gt 2 ]; then
  echo "Error: too many arguments." >&2
  usage
  exit 1
fi

if [ -z "$PLAY_EXISTING_FILE" ] && [ -z "${POSITIONAL[0]:-}" ]; then
  usage
  exit 1
fi

if [ -n "$VOICE_ID" ] && [ -n "${POSITIONAL[1]:-}" ]; then
  echo "Error: pass either --voice-id or a positional voice, not both." >&2
  usage
  exit 1
fi

TEXT=$(normalize_space "${POSITIONAL[0]:-}")
INTRODUCTION=$(normalize_space "$INTRODUCTION")
SUBJECT=$(normalize_space "$SUBJECT")
AGENT_NAME=$(normalize_space "$AGENT_NAME")
AGENT_ID="$(agent_identity)"
VOICE_SEED="$AGENT_ID"
if [ -n "$AGENT_NAME" ]; then
  VOICE_SEED="$AGENT_NAME"
fi
VOICE="${VOICE_ID:-${POSITIONAL[1]:-}}"
if [ -z "$VOICE" ] && [ -z "$PLAY_EXISTING_FILE" ]; then
  VOICE="$(select_voice_from_seed "$VOICE_SEED")"
fi
INTRO_STATE_DIR="$(intro_state_dir)"
INTRO_STATE_FILE="$INTRO_STATE_DIR/last-speaker"

if [ -n "$SUBJECT" ] && [ -z "$PLAY_EXISTING_FILE" ]; then
  SUBJECT_WORDS=$(word_count "$SUBJECT")
  if [ "$SUBJECT_WORDS" -lt 5 ] || [ "$SUBJECT_WORDS" -gt 10 ]; then
    echo "Error: --subject must be between 5 and 10 words." >&2
    exit 1
  fi
  TEXT=$(prepend_spoken_segment "$SUBJECT" "$TEXT")
fi

if [ -n "$INTRODUCTION" ] && [ -z "$PLAY_EXISTING_FILE" ]; then
  INTRO_WORDS=$(word_count "$INTRODUCTION")
  if [ "$INTRO_WORDS" -gt 30 ]; then
    echo "Error: --introduction must be 30 words or fewer." >&2
    exit 1
  fi

  if should_prepend_introduction; then
    TEXT=$(prepend_spoken_segment "$INTRODUCTION" "$TEXT")
  fi
fi

OUTPUT_FILE="${TTS_OUTPUT_FILE:-/tmp/tts_${RANDOM}.mp3}"
TMP_ERR="/tmp/tts_error_${RANDOM}.log"
PAUSED_MEDIA_APPS=()

media_control_enabled() {
  case "$MEDIA_CONTROL" in
    0|false|False|FALSE|no|No|NO|off|Off|OFF)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

app_is_running() {
  local app="$1"
  pgrep -x "$app" >/dev/null 2>&1
}

scriptable_player_state() {
  local app="$1"
  osascript -e "tell application \"$app\" to player state as string" 2>/dev/null || true
}

scriptable_player_command() {
  local app="$1"
  local command="$2"
  osascript -e "tell application \"$app\" to $command" >/dev/null 2>&1
}

pause_media_if_playing() {
  if ! media_control_enabled || ! command -v osascript >/dev/null 2>&1 || ! command -v pgrep >/dev/null 2>&1; then
    return
  fi

  local app state
  local paused_now=()
  local media_apps="${TTS_MEDIA_APPS:-Music,Spotify}"
  local old_ifs="$IFS"
  IFS=','
  # shellcheck disable=SC2206
  local apps=($media_apps)
  IFS="$old_ifs"

  for app in "${apps[@]}"; do
    app=$(printf '%s' "$app" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ -z "$app" ] || ! app_is_running "$app"; then
      continue
    fi

    state="$(scriptable_player_state "$app")"
    if [ "$state" = "playing" ]; then
      if scriptable_player_command "$app" "pause"; then
        PAUSED_MEDIA_APPS+=("$app")
        paused_now+=("$app")
      fi
    fi
  done

  if [ "${#paused_now[@]}" -gt 0 ]; then
    echo "Paused media: ${paused_now[*]}" >&2
  fi
}

resume_paused_media() {
  if [ "${#PAUSED_MEDIA_APPS[@]}" -eq 0 ]; then
    return
  fi

  local delay="${1:-$RESUME_DELAY}"
  sleep "$delay" 2>/dev/null || true

  local app
  for app in "${PAUSED_MEDIA_APPS[@]}"; do
    if app_is_running "$app"; then
      scriptable_player_command "$app" "play" || true
    fi
  done
  PAUSED_MEDIA_APPS=()
}

cleanup() {
  local exit_code=$?
  trap - EXIT
  set +e
  rm -f "$TMP_ERR"
  resume_paused_media
  release_speech_gate
  exit "$exit_code"
}

trap cleanup EXIT

if [ -n "$PLAY_EXISTING_FILE" ]; then
  OUTPUT_FILE="$PLAY_EXISTING_FILE"
  if [ ! -s "$OUTPUT_FILE" ]; then
    echo "Error: playback file does not exist or is empty: $OUTPUT_FILE" >&2
    exit 1
  fi

  acquire_speech_gate
  record_agent_spoken
  pause_media_if_playing

  PLAYED=0
  if command -v afplay >/dev/null 2>&1; then
    afplay "$OUTPUT_FILE"
    PLAYED=1
  elif command -v xdg-open >/dev/null 2>&1; then
    if xdg-open "$OUTPUT_FILE" >/dev/null 2>&1; then
      PLAYED=1
    fi
  else
    echo "Tip: open the file manually: $OUTPUT_FILE"
  fi

  if [ "$PLAYED" -eq 1 ]; then
    record_agent_spoken
  fi
  exit 0
fi

if [ -z "${KOKORO_API_ENDPOINT:-}" ]; then
  echo "Error: KOKORO_API_ENDPOINT is not set." >&2
  echo "No KOKORO_API_ENDPOINT env var is set. Read references/setup.md for instructions on how to set it up." >&2
  exit 1
fi

API_URL="$KOKORO_API_ENDPOINT"
if [[ "$API_URL" != */v1/audio/speech ]]; then
  API_URL="${API_URL%/}/v1/audio/speech"
fi

if command -v python3 >/dev/null 2>&1; then
  PAYLOAD=$(python3 - "$TEXT" "$VOICE" <<'PY'
import json
import sys
text = sys.argv[1]
voice = sys.argv[2]
print(json.dumps({
    "model": "kokoro",
    "input": text,
    "voice": voice,
    "response_format": "mp3",
}))
PY
)
else
  PAYLOAD="{\"model\":\"kokoro\",\"input\":\"$TEXT\",\"voice\":\"$VOICE\",\"response_format\":\"mp3\"}"
fi

CURL_OPTS=(curl -sS -X POST -H "Content-Type: application/json" -d "$PAYLOAD")

if [ -n "${KOKORO_API_KEY:-}" ]; then
  CURL_OPTS+=( -H "Authorization: Bearer $KOKORO_API_KEY" )
elif [ -n "${KOKORO_API_USERNAME:-}" ] && [ -n "${KOKORO_API_PASSWORD:-}" ]; then
  CURL_OPTS+=( -u "$KOKORO_API_USERNAME:$KOKORO_API_PASSWORD" )
fi

CURL_OPTS+=( "$API_URL" )

pause_media_if_playing

set +e
HTTP_CODE=$("${CURL_OPTS[@]}" -w "%{http_code}" -o "$OUTPUT_FILE" 2>"$TMP_ERR")
CURL_STATUS=$?
set -e

if [ "$CURL_STATUS" -ne 0 ]; then
  echo "Error: failed to call TTS endpoint" >&2
  cat "$TMP_ERR" >&2 || true
  rm -f "$TMP_ERR" "$OUTPUT_FILE"
  exit 1
fi
rm -f "$TMP_ERR"

if [ "$HTTP_CODE" -lt 200 ] || [ "$HTTP_CODE" -ge 300 ]; then
  echo "Error: TTS request failed with HTTP $HTTP_CODE" >&2
  rm -f "$OUTPUT_FILE"
  exit 1
fi

if [ ! -s "$OUTPUT_FILE" ]; then
  echo "Error: Empty response from TTS server" >&2
  rm -f "$OUTPUT_FILE"
  exit 1
fi

if [ "$NO_PLAY" -eq 1 ]; then
  echo "$OUTPUT_FILE"
  exit 0
fi

echo "✓ Generated: $OUTPUT_FILE"
if macos_menu_enabled && queue_macos_playback; then
  exit 0
fi

state_dir="$(tts_state_dir)"
if ! mkdir -p "$state_dir" 2>/dev/null; then
  state_dir="/tmp/tts-state"
  mkdir -p "$state_dir" 2>/dev/null || state_dir="/tmp"
fi
log_file="$state_dir/tts-playback-$(date +%Y%m%d-%H%M%S)-$$.log"
playback_args=(--play-existing "$OUTPUT_FILE")
if [ -n "$AGENT_NAME" ]; then
  playback_args+=(--agent-name "$AGENT_NAME")
fi
nohup env \
  TTS_CALLER_PPID="${TTS_CALLER_PPID:-$PPID}" \
  TTS_MEDIA_CONTROL="$MEDIA_CONTROL" \
  TTS_RESUME_DELAY_SECONDS="$RESUME_DELAY" \
  "$0" "${playback_args[@]}" \
  </dev/null >>"$log_file" 2>&1 &
pid=$!
disown "$pid" 2>/dev/null || true
printf 'Queued TTS playback in background: pid %s, log %s\n' "$pid" "$log_file" >&2
