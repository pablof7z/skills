#!/usr/bin/env python3
"""Thin installed-skill adapter for the standalone TTS29 local CLI."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

from tts29_request import (
    RequestError,
    build_artifacts,
    build_questions,
    build_request,
    parse_duration,
    select_voice,
)


LEGACY_COMMANDS = {"pair", "remote", "daemon"}
LEGACY_FLAGS = {
    "--attach": "local attachment paths are retired; upload the artifact through TTS29 and pass --artifact with its durable descriptor",
    "--no-play": "generation-only playback control is retired; TTS29 producers publish durable items and players decide playback independently",
    "--play-existing": "skill-owned playback is retired; open the durable item in a TTS29 player",
}


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Publish one durable spoken item through a standalone TTS29 daemon."
    )
    result.add_argument("--agent-name", required=True)
    result.add_argument("--subject", required=True)
    result.add_argument("--summary", required=True)
    result.add_argument("--message", required=True)
    result.add_argument("--ask", nargs="?", const="", metavar="JSON_OR_@FILE")
    result.add_argument("--suggestions", metavar="JSON")
    result.add_argument("--wait", metavar="DURATION")
    result.add_argument("--artifact", action="append", default=[], metavar="JSON_OR_@FILE")
    result.add_argument("--request-id")
    result.add_argument("--voice")
    result.add_argument("--socket")
    return result


def refuse_legacy(arguments: list[str]) -> None:
    if arguments and arguments[0] in LEGACY_COMMANDS:
        raise RequestError(
            f"legacy {arguments[0]} administration is retired; configure the standalone TTS29 product"
        )
    for flag, guidance in LEGACY_FLAGS.items():
        if flag in arguments:
            raise RequestError(guidance)


def configured(name: str) -> str | None:
    value = os.environ.get(name)
    return value if value and value.strip() else None


def run(arguments: list[str]) -> int:
    refuse_legacy(arguments)
    options = parser().parse_args(arguments)
    group_id = configured("TTS29_GROUP_ID")
    if group_id is None:
        raise RequestError("TTS29_GROUP_ID is required; configure the standalone product group")
    socket = options.socket if options.socket is not None else configured("TTS29_SOCKET")
    if not socket:
        raise RequestError("TTS29_SOCKET or --socket is required for the standalone daemon")
    if options.ask is None and options.wait is not None:
        raise RequestError("--wait requires --ask")
    if options.ask is not None and options.wait is None:
        raise RequestError("--ask requires --wait between 1 second and 5 minutes")

    questions, preamble = build_questions(
        options.ask, options.suggestions, options.message, options.subject
    )
    body = options.message.strip()
    if preamble:
        body = f"{body}\n\n{preamble}"
    request = build_request(
        request_id=(
            options.request_id
            if options.request_id is not None
            else configured("TTS29_REQUEST_ID")
        ),
        group_id=group_id,
        voice=(
            options.voice
            if options.voice is not None
            else configured("TTS29_VOICE") or select_voice(options.agent_name)
        ),
        agent_name=options.agent_name,
        subject=options.subject,
        summary=options.summary,
        body=body,
        artifacts=build_artifacts(options.artifact),
        questions=questions,
    )
    command = [configured("TTS29_CLI") or "tts29", "--socket", socket]
    if options.wait is not None:
        command.extend(["--wait-seconds", str(parse_duration(options.wait))])
    try:
        completed = subprocess.run(
            command,
            input=json.dumps(request, ensure_ascii=False, separators=(",", ":")),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except (FileNotFoundError, PermissionError) as error:
        raise RequestError(
            "the standalone tts29 CLI is unavailable; install it or set TTS29_CLI"
        ) from error

    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or "unknown daemon error"
        print(f"TTS29 publication failed: {detail}", file=sys.stderr)
        return completed.returncode
    try:
        response = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise RequestError("the standalone tts29 CLI returned invalid JSON") from error
    if not isinstance(response, dict) or response.get("status") != "published":
        raise RequestError("the standalone tts29 CLI returned an unexpected response")
    print(json.dumps(response, ensure_ascii=False, separators=(",", ":")))
    return 0


def main() -> int:
    try:
        return run(sys.argv[1:])
    except RequestError as error:
        print(f"tts: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
