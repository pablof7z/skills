#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR/../mcp"

if ! command -v uv >/dev/null 2>&1; then
  echo "Error: uv is required to run the TTS MCP server." >&2
  exit 1
fi

exec uv run --project "$PROJECT_DIR" python "$SCRIPT_DIR/tts_mcp_server.py" "$@"
