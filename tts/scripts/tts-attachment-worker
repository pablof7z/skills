#!/usr/bin/env python3
"""Prepare narrated TTS attachments without delaying the primary message."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def atomic_write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".tts-item-", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def update_attachment(item_path: Path, attachment_id: str, **changes: object) -> None:
    with item_path.open(encoding="utf-8") as handle:
        item = json.load(handle)
    for attachment in item.get("attachments") or []:
        if attachment.get("id") == attachment_id:
            attachment.update(changes)
            break
    atomic_write_json(item_path, item)


def markdown_for_speech(value: str) -> str:
    value = re.sub(r"```.*?```", " Code sample omitted. ", value, flags=re.DOTALL)
    value = re.sub(r"!\[([^]]*)\]\([^)]+\)", r"\1", value)
    value = re.sub(r"\[([^]]+)\]\([^)]+\)", r"\1", value)
    value = re.sub(r"^\s{0,3}(?:#{1,6}|>|[-+*]|\d+[.)])\s+", "", value, flags=re.MULTILINE)
    value = re.sub(r"[`*_~]", "", value)
    return re.sub(r"\s+", " ", value).strip()


def prepare(item_path: Path, attachment: dict, voice: str, tts_command: Path) -> None:
    attachment_id = str(attachment["id"])
    source = Path(str(attachment["source_file"]))
    audio = Path(str(attachment["audio_file"]))
    timings = audio.with_name("timings.json")
    try:
        text = source.read_text(encoding="utf-8")
        speech = markdown_for_speech(text)
        if not speech:
            raise ValueError("The attachment did not contain narratable text.")
        update_attachment(item_path, attachment_id, status="preparing", error=None)
        environment = os.environ.copy()
        environment.update(
            {
                "TTS_INTERNAL_ATTACHMENT_GENERATION": "1",
                "TTS_OUTPUT_FILE": str(audio),
                "TTS_TIMESTAMPS_FILE": str(timings),
            }
        )
        result = subprocess.run(
            [str(tts_command), "--no-play", "--voice-id", voice, "--message", speech],
            env=environment,
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            check=False,
        )
        if result.returncode != 0 or not audio.is_file() or audio.stat().st_size == 0:
            detail = result.stderr.strip().splitlines()
            raise RuntimeError(detail[-1] if detail else "Narration generation failed.")
        word_timings = None
        if timings.is_file():
            try:
                word_timings = json.loads(timings.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                word_timings = None
        update_attachment(
            item_path,
            attachment_id,
            status="ready",
            audio_file=str(audio),
            word_timings=word_timings,
            error=None,
        )
    except Exception as error:  # Keep the worker alive for the remaining assets.
        update_attachment(item_path, attachment_id, status="failed", error=str(error))


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: tts-attachment-worker ITEM_JSON", file=sys.stderr)
        return 2
    item_path = Path(sys.argv[1]).expanduser().resolve()
    with item_path.open(encoding="utf-8") as handle:
        item = json.load(handle)
    voice = str(item["voice"])
    tts_command = Path(__file__).resolve().with_name("tts")
    for attachment in item.get("attachments") or []:
        if attachment.get("kind") == "narrated_text" and attachment.get("status") == "preparing":
            prepare(item_path, attachment, voice, tts_command)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
