#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_DIR="$SCRIPT_DIR/../macos"
BINARY="$PACKAGE_DIR/.build/release/TTSMenuBar"
APP_BUNDLE="$PACKAGE_DIR/.build/release/TTSMenuBar.app"
APP_EXECUTABLE="$APP_BUNDLE/Contents/MacOS/TTSMenuBar"
APP_INFO="$APP_BUNDLE/Contents/Info.plist"
APP_RESOURCES="$APP_BUNDLE/Contents/Resources"
APP_ICON_SOURCE="$PACKAGE_DIR/Resources/TTSMenuBar.icns"
APP_ICON="$APP_RESOURCES/TTSMenuBar.icns"

tts_state_dir() {
  if [ -n "${TTS_STATE_DIR:-}" ]; then
    printf '%s\n' "$TTS_STATE_DIR"
  elif [ -n "${XDG_STATE_HOME:-}" ]; then
    printf '%s/tts\n' "$XDG_STATE_HOME"
  elif [ -n "${HOME:-}" ]; then
    printf '%s/.local/state/tts\n' "$HOME"
  else
    printf '/tmp/tts-state\n'
  fi
}

STATE_DIR="$(tts_state_dir)"
PID_FILE="$STATE_DIR/menu.pid"
LOCK_DIR="$STATE_DIR/menu.lock"
LOG_FILE="$STATE_DIR/menu.log"

usage() {
  echo "Usage: ./scripts/tts-menu <start|stop|restart|status> [--json]" >&2
  echo "       ./scripts/tts-menu queue <list|get|wait|archive|restore|supersede> [options]" >&2
}

process_is_alive() {
  local pid="${1:-}"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

active_pid() {
  local pid=""
  if [ -r "$PID_FILE" ]; then
    IFS= read -r pid < "$PID_FILE" || true
  fi
  if process_is_alive "$pid"; then
    printf '%s\n' "$pid"
    return 0
  fi
  return 1
}

stage_app_bundle() {
  mkdir -p "$APP_BUNDLE/Contents/MacOS" "$APP_RESOURCES"
  if [ ! -x "$APP_EXECUTABLE" ] || [ "$BINARY" -nt "$APP_EXECUTABLE" ]; then
    cp "$BINARY" "$APP_EXECUTABLE"
    chmod +x "$APP_EXECUTABLE"
  fi
  if [ ! -f "$APP_ICON" ] || [ "$APP_ICON_SOURCE" -nt "$APP_ICON" ]; then
    cp "$APP_ICON_SOURCE" "$APP_ICON"
  fi
  cat > "$APP_INFO" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>TTSMenuBar</string>
  <key>CFBundleIdentifier</key>
  <string>com.pablof7z.tts-menu</string>
  <key>CFBundleIconFile</key>
  <string>TTSMenuBar.icns</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>TTS Queue</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>Open the iTerm session associated with a TTS update and manage supported media playback.</string>
</dict>
</plist>
PLIST
  touch "$APP_BUNDLE"
}

build_if_needed() {
  local newer=""
  if [ -x "$BINARY" ]; then
    newer="$(find "$PACKAGE_DIR/Package.swift" "$PACKAGE_DIR/Sources" -type f -newer "$BINARY" -print -quit 2>/dev/null || true)"
  fi

  if [ ! -x "$BINARY" ] || [ -n "$newer" ]; then
    if ! command -v swift >/dev/null 2>&1; then
      echo "Error: Swift is required to build the TTS macOS app." >&2
      return 1
    fi

    mkdir -p "$STATE_DIR"
    if ! swift build --package-path "$PACKAGE_DIR" --configuration release >>"$LOG_FILE" 2>&1; then
      echo "Error: failed to build the TTS macOS app. Log: $LOG_FILE" >&2
      tail -n 30 "$LOG_FILE" >&2 || true
      return 1
    fi
  fi

  stage_app_bundle
}

start_menu() {
  local pid
  mkdir -p "$STATE_DIR/items"

  if pid="$(active_pid 2>/dev/null)"; then
    printf 'TTS app is running: pid %s\n' "$pid"
    return 0
  fi

  build_if_needed
  rm -f "$PID_FILE"

  if ! open -n "$APP_BUNDLE" --args --state-dir "$STATE_DIR"; then
    echo "Error: Launch Services could not open the TTS app." >&2
    return 1
  fi

  for _ in {1..60}; do
    if pid="$(active_pid 2>/dev/null)"; then
      printf 'TTS app started: pid %s\n' "$pid"
      return 0
    fi
    sleep 0.1
  done

  echo "Error: TTS app did not start. Log: $LOG_FILE" >&2
  tail -n 30 "$LOG_FILE" >&2 || true
  return 1
}

recover_interrupted_items() {
  command -v python3 >/dev/null 2>&1 || return 0
  python3 "$SCRIPT_DIR/tts-menu-recover.py" "$STATE_DIR"
}

stop_menu() {
  local pid=""
  if ! pid="$(active_pid 2>/dev/null)"; then
    rm -f "$PID_FILE"
    rm -rf "$LOCK_DIR"
    recover_interrupted_items
    echo "TTS app is not running."
    return 0
  fi

  kill "$pid" 2>/dev/null || true
  for _ in {1..50}; do
    if ! process_is_alive "$pid"; then
      break
    fi
    sleep 0.1
  done
  if process_is_alive "$pid"; then
    echo "Error: TTS app did not stop." >&2
    return 1
  fi

  rm -f "$PID_FILE"
  rm -rf "$LOCK_DIR"
  recover_interrupted_items
  echo "TTS app stopped."
}

print_status() {
  local json_output="${1:-0}"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required to read TTS queue status." >&2
    return 1
  fi

  python3 "$SCRIPT_DIR/tts-menu-status.py" "$STATE_DIR" "$json_output"
}

queue_command() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required to manage the TTS queue." >&2
    return 1
  fi

  TTS_MENU_SELF="$SCRIPT_DIR/tts-menu" python3 "$SCRIPT_DIR/tts-menu-queue.py" "$STATE_DIR" "$@"
}

command="${1:-}"
case "$command" in
  start)
    start_menu
    ;;
  stop)
    stop_menu
    ;;
  restart)
    stop_menu
    start_menu
    ;;
  status)
    if [ "${2:-}" = "--json" ]; then
      print_status 1
    elif [ -n "${2:-}" ]; then
      usage
      exit 1
    else
      print_status 0
    fi
    ;;
  queue)
    shift
    queue_command "$@"
    ;;
  --help|-h|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
