#!/usr/bin/env bash
set -euo pipefail

payload=""
output=""
url=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    -d|-o|-w|-X|-H|-u)
      option="$1"
      value="${2:-}"
      case "$option" in
        -d) payload="$value" ;;
        -o) output="$value" ;;
      esac
      shift 2
      ;;
    -s|-S|-sS)
      shift
      ;;
    *)
      url="$1"
      shift
      ;;
  esac
done

printf '%s' "$payload" > "$MOCK_TTS_CAPTURE"

if [[ "$url" == */dev/captioned_speech ]] && [ "${MOCK_CAPTION_STATUS:-200}" != "200" ]; then
  printf '{"error":"caption route unavailable"}\n' > "$output"
  printf '%s' "$MOCK_CAPTION_STATUS"
  exit 0
fi

if [[ "$url" == */dev/captioned_speech ]]; then
  printf '{"audio":"YXVkaW8=","timestamps":[]}\n' > "$output"
else
  printf 'audio' > "$output"
fi
printf '200'
