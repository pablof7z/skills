#!/bin/sh
# wb — whiteboard block document CLI shim.
# Resolves its own symlink chain so it works when installed on PATH
# (e.g. ~/.local/bin/wb -> .../whiteboard/bin/wb) regardless of where it's invoked.
prog="$0"
while [ -L "$prog" ]; do
  dir=$(cd -P "$(dirname "$prog")" >/dev/null 2>&1 && pwd)
  prog=$(readlink "$prog")
  case "$prog" in
    /*) ;;
    *) prog="$dir/$prog" ;;
  esac
done
dir=$(cd -P "$(dirname "$prog")" >/dev/null 2>&1 && pwd)
exec node "$dir/../cli/main.mjs" "$@"