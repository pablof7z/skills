#!/bin/sh
# wb — whiteboard block document CLI shim.
# Resolve symlinks so this works whether invoked directly, via a PATH symlink
# (e.g. ~/.local/bin/wb -> here), or through the skill's bin/ path.
self="$0"
while [ -L "$self" ]; do
  target=$(readlink "$self") || break
  case "$target" in
    /*) self="$target" ;;
    *) dir=$(cd "$(dirname "$self")" && pwd); self="$dir/$target" ;;
  esac
done
exec node "$(dirname "$self")/../cli/main.mjs" "$@"