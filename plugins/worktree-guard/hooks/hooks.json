{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|run_terminal_command|run_terminal_cmd|apply_patch|Edit|Write|MultiEdit|NotebookEdit|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT:-${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}}/bin/wtg-hook-dispatch pre-tool-use",
            "timeout": 5,
            "statusMessage": "Checking base-checkout mutation"
          }
        ]
      }
    ]
  }
}
