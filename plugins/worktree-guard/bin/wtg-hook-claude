#!/usr/bin/env python3
"""Claude Code hook entrypoint for WorktreeGuard.

See also `wtg-hook-codex`, the Codex counterpart of this shim; both delegate
to the shared `wtg hook <harness> <event>` surface in
`lib/worktreeguard/`. Use the bundled WorktreeGuard command
shipped inside this plugin package by default so cache fallback hooks are
self-contained. Set `WTG_BIN` to route hook events to a different
WorktreeGuard command.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def main() -> int:
    event = sys.argv[1] if len(sys.argv) > 1 else "hook"
    stdin = sys.stdin.buffer.read()
    wtg_bin = select_wtg_binary()
    harness = payload_harness(stdin)

    env = os.environ.copy()
    env.setdefault("WTG_COMMAND", str(wtg_bin))

    result = subprocess.run(
        [str(wtg_bin), "hook", harness, event],
        input=stdin,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        check=False,
    )
    sys.stdout.buffer.write(result.stdout)
    sys.stderr.buffer.write(result.stderr)
    return result.returncode


def payload_harness(stdin: bytes) -> str:
    try:
        payload = json.loads(stdin)
    except (json.JSONDecodeError, UnicodeDecodeError):
        return "claude"
    if not isinstance(payload, dict):
        return "claude"
    transcript_path = str(payload.get("transcript_path") or payload.get("transcriptPath") or "")
    if "/.codex/" in transcript_path:
        return "codex"
    model = str(payload.get("model") or "").lower()
    if model.startswith("gpt-") and "/.claude/" not in transcript_path:
        return "codex"
    return "claude"


def select_wtg_binary() -> Path:
    override = os.environ.get("WTG_BIN")
    if override:
        return Path(override).expanduser().resolve(strict=False)

    plugin_root = Path(__file__).resolve().parents[1]
    bundled = plugin_root / "bin" / "wtg"
    if bundled.is_file():
        return bundled

    external = shutil.which("wtg")
    if external:
        return Path(external).resolve(strict=False)

    return bundled


if __name__ == "__main__":
    raise SystemExit(main())
