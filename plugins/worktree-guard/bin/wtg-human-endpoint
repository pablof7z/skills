#!/usr/bin/env python3
"""WorktreeGuard adapter for the shared human-endpoint protocol CLI."""

from __future__ import annotations

import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT))

try:
    from human_endpoint_protocol.cli import main
except ModuleNotFoundError:
    print(
        json.dumps(
            {
                "ok": False,
                "code": "missing_dependency",
                "message": "human_endpoint_protocol is not available in this installed WorktreeGuard artifact.",
            },
            sort_keys=True,
        ),
        file=sys.stderr,
    )
    raise SystemExit(1)


if __name__ == "__main__":
    raise SystemExit(main())
