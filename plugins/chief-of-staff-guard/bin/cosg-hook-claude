#!/usr/bin/env python3
"""Claude Code hook entrypoint for ChiefOfStaffGuard.

See also `cosg-hook-codex`, the Codex counterpart of this shim; both delegate
to the shared `cosg hook <harness> <event>` surface in
`lib/chiefofstaffguard/`. Use the bundled ChiefOfStaffGuard command shipped
inside this plugin package by default so cache fallback hooks are
self-contained. Set `COSG_BIN` to route hook events to a different
ChiefOfStaffGuard command.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


def main() -> int:
    event = sys.argv[1] if len(sys.argv) > 1 else "hook"
    stdin = sys.stdin.buffer.read()
    cosg_bin = select_cosg_binary()
    harness = payload_harness(stdin)

    env = os.environ.copy()
    env.setdefault("COSG_COMMAND", str(cosg_bin))

    result = subprocess.run(
        [str(cosg_bin), "hook", harness, event],
        input=stdin,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        check=False,
    )
    sys.stdout.buffer.write(result.stdout)
    sys.stderr.buffer.write(result.stderr)
    return result.returncode


def payload_harness(stdin: bytes) -> str:
    try:
        payload = json.loads(stdin)
    except (json.JSONDecodeError, UnicodeDecodeError):
        return "claude"
    if not isinstance(payload, dict):
        return "claude"
    transcript_path = str(payload.get("transcript_path") or payload.get("transcriptPath") or "")
    if "/.codex/" in transcript_path:
        return "codex"
    model = str(payload.get("model") or "").lower()
    if model.startswith("gpt-") and "/.claude/" not in transcript_path:
        return "codex"
    return "claude"


def select_cosg_binary() -> Path:
    override = os.environ.get("COSG_BIN")
    if override:
        return Path(override).expanduser().resolve(strict=False)

    plugin_root = Path(__file__).resolve().parents[1]
    bundled = plugin_root / "bin" / "cosg"
    if bundled.is_file():
        return bundled

    external = shutil.which("cosg")
    if external:
        return Path(external).resolve(strict=False)

    return bundled


if __name__ == "__main__":
    raise SystemExit(main())
